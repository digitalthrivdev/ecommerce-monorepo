# API settings for one client's production deployment. Copy to api.env (never commit it).
# compose.yml sets NODE_ENV, HOST, PORT, DATABASE_URL, REDIS_URL, PUBLIC_API_URL, PUBLIC_SITE_URL
# and TRUST_PROXY, and passes SENTRY_DSN from .env;
# all other options are documented in apps/api/.env.example.

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts payment gateway and SMS provider keys saved in the admin dashboard.
# Generate: openssl rand -base64 32. Changing it means re-entering those keys.
SECRETS_ENCRYPTION_KEY=

# Initial branding and pricing; afterwards admins change them in the dashboard.
APP_NAME=Shop
# Quote colours: an unquoted "#" starts a comment
PRIMARY_COLOR="#0C831F"
SECONDARY_COLOR="#F8CB46"
TIMEZONE=Asia/Kolkata
CURRENCY=INR
SHIPPING_FEE=25.00
FREE_SHIPPING_THRESHOLD=199.00
COD_FEE=0.00
MIN_ORDER_VALUE=99.00

PAYMENT_TIMEOUT_MINUTES=15
PAYMENT_SWEEP_INTERVAL_SECONDS=60

OTP_SENDS_PER_IP_PER_HOUR=30

# "none" until push notifications are set up ("log" is not allowed in production).
PUSH_PROVIDER=none
NOTIFICATION_INTERVAL_SECONDS=3

# Optional: environment credentials take priority over keys saved in the dashboard.
# Uncomment and fill each complete carrier group, or leave the entire group commented out.
# Shiprocket (all four required together):
# SHIPROCKET_API_EMAIL=
# SHIPROCKET_API_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# SHIPROCKET_PICKUP_LOCATION=
# Fship (both required together):
# FSHIP_CLIENT_KEY=
# FSHIP_PICKUP_ADDRESS_ID=
# Optional Fship staging endpoint (production default is https://capi.fship.in):
# FSHIP_BASE_URL=https://capi-qc.fship.in
# Payment, SMS and OTP settings are listed in apps/api/.env.example:
# RAZORPAY_*, CASHFREE_*, MESSAGE_CENTRAL_*, OTP_PROVIDER.

# Sales demo instances only: test-account logins shown on the sign-in screens for one-tap sign-in.
# Public (anyone can read them), so only test accounts. Leave unset for real clients.
# DEMO_LOGINS='{"admin":{"email":"demo.admin@example.com","password":"…"},"customer":{"phone":"+919000000003","code":"123456"}}'
