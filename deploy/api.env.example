# API settings for one client's production deployment. Copy to api.env (never commit it).
# compose.yml sets NODE_ENV, HOST, PORT, DATABASE_URL, REDIS_URL, PUBLIC_API_URL and TRUST_PROXY;
# all other options are documented in apps/api/.env.example.

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts payment gateway and SMS provider keys saved in the admin dashboard.
# Generate: openssl rand -base64 32. Changing it means re-entering those keys.
SECRETS_ENCRYPTION_KEY=

# Initial branding and pricing; afterwards admins change them in the dashboard.
APP_NAME=Grocery
# Quote colours: an unquoted "#" starts a comment
PRIMARY_COLOR="#0C831F"
SECONDARY_COLOR="#F8CB46"
TIMEZONE=Asia/Kolkata
CURRENCY=INR
DELIVERY_FEE=25.00
FREE_DELIVERY_THRESHOLD=199.00
MIN_ORDER_VALUE=99.00
DELIVERY_PARTNER_FEE=30.00

PAYMENT_TIMEOUT_MINUTES=15
PAYMENT_SWEEP_INTERVAL_SECONDS=60

OTP_SENDS_PER_IP_PER_HOUR=30

# "none" until push notifications are set up ("log" is not allowed in production).
PUSH_PROVIDER=none
NOTIFICATION_INTERVAL_SECONDS=3

# Optional: payment and SMS keys can be set here instead of in the dashboard (here wins).
# See apps/api/.env.example for RAZORPAY_*, CASHFREE_*, MESSAGE_CENTRAL_* and OTP_PROVIDER.
