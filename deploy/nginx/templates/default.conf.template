# ${API_DOMAIN} and ${ADMIN_DOMAIN} are filled in from the environment when Nginx starts.
# One certificate (name "grocery") covers both domains; see init-letsencrypt.sh.

server_tokens off;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

proxy_http_version 1.1;
proxy_set_header Host $host;
# Overwrite rather than append, so clients cannot add fake addresses (the API trusts one hop).
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_read_timeout 60s;

server {
    listen 80;
    server_name ${API_DOMAIN} ${ADMIN_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/grocery/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grocery/privkey.pem;

    client_max_body_size 2m;

    # Uploaded images. File names change whenever the content does, so they can be cached for good.
    location /uploads/ {
        alias /srv/uploads/;
        autoindex off;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
        add_header Cross-Origin-Resource-Policy cross-origin;
    }

    location / {
        proxy_pass http://api:4000;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/grocery/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grocery/privkey.pem;

    # Image uploads (up to 10 MB) pass through the dashboard.
    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://admin:3000;
    }
}

# Requests for any other host name (e.g. the bare server IP) are dropped.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_certificate /etc/letsencrypt/live/grocery/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grocery/privkey.pem;
    return 444;
}
