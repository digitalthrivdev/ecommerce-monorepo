# Deployment settings for one client. Copy to .env (never commit it) and fill in.
#
# Setting up a new client on a VPS with Docker Engine:
#   1. Point the domains below, and www.SITE_DOMAIN, at the server (DNS A records). Open ports 80
#      and 443.
#   2. git clone the repository, then: cd deploy && cp .env.example .env && cp api.env.example api.env
#   3. Fill in both files, then: ./init-letsencrypt.sh
#   4. Create the first admin (asks for the password; run it again later to reset it):
#        docker compose run --rm api node dist/scripts/create-admin.js --email you@example.com --phone +91XXXXXXXXXX --name "Name"
#   5. Sign in at https://ADMIN_DOMAIN with that email and password.
#      Then under Settings add the SMS provider keys (for customer sign-in) and payment gateway keys.
#   6. Build the mobile apps with EXPO_PUBLIC_API_URL=https://API_DOMAIN.
#
# Updating: ./update.sh   (git pull, then builds on the server; migrations run automatically)
# Logs: docker compose logs -f api
# Backups: ./backups (daily). Copy them to another machine or storage regularly.

# Distinguishes this client's containers and volumes if several run on one server.
COMPOSE_PROJECT_NAME=shop

API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Public website: home page and the policy pages payment gateways and app stores ask for.
# www.SITE_DOMAIN redirects here.
SITE_DOMAIN=example.com
LETSENCRYPT_EMAIL=ops@example.com

# Product links shared from the customer app (https://SITE_DOMAIN/p/<id>) open the app when it's
# installed (docs/deployment.md, "Product links"). Blank: they always open the website.
# The customer app's APP_ID, and the SHA-256 fingerprints of its signing keys, comma-separated
# (the EAS keystore, plus Google Play's app signing key once the app is on Play).
ANDROID_APP_ID=
ANDROID_CERT_SHA256=
# "<Apple Team ID>.<APP_ID>", once there's an iOS app.
IOS_APP_ID=

# Letters and digits only (it goes into a connection URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

BACKUP_KEEP_DAYS=14

# Error tracking for the API, dashboard and website: the DSN of this client's Sentry project
# (docs/deployment.md, "Error tracking and uptime"). Blank turns it off.
SENTRY_DSN=

# Change only if something else on the server uses these ports.
# HTTP_PORT=80
# HTTPS_PORT=443

# On a server where Coolify's proxy already uses ports 80 and 443 (docs/deployment.md, "Servers
# running Coolify"):
# COMPOSE_FILE=compose.yml:compose.coolify.yml
