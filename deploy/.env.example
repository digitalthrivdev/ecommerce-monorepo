# Deployment settings for one client. Copy to .env (never commit it) and fill in.
#
# Setting up a new client on a VPS with Docker Engine:
#   1. Point both domains below at the server (DNS A records). Open ports 80 and 443.
#   2. git clone the repository, then: cd deploy && cp .env.example .env && cp api.env.example api.env
#   3. Fill in both files, then: ./init-letsencrypt.sh
#   4. Create the first admin:
#        docker compose run --rm api node dist/scripts/create-admin.js --phone +91XXXXXXXXXX --name "Name"
#   5. Sign in at https://ADMIN_DOMAIN. Until an SMS provider is set up, read the code with:
#        docker compose logs api | grep "Login OTP"
#      Then under Settings add the SMS provider keys and payment gateway keys.
#   6. Build the mobile apps with EXPO_PUBLIC_API_URL=https://API_DOMAIN.
#
# Updating: git pull && docker compose up -d --build   (migrations run automatically)
# Logs: docker compose logs -f api
# Backups: ./backups (daily). Copy them to another machine or storage regularly.

# Distinguishes this client's containers and volumes if several run on one server.
COMPOSE_PROJECT_NAME=grocery

API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Letters and digits only (it goes into a connection URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

BACKUP_KEEP_DAYS=14

# Change only if something else on the server uses these ports.
# HTTP_PORT=80
# HTTPS_PORT=443
