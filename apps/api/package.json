{
  "name": "@grocery/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "prisma db seed",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "latest",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@grocery/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.75.2",
    "dotenv": "^18.0.4",
    "fastify": "latest",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^5.0.3"
  }
}
