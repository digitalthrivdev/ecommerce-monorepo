generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id    String   @id @default(cuid())
  phone String   @unique
  name  String?
  // Stored lowercase. Admins and store staff sign in with it.
  email String?  @unique
  role  UserRole @default(CUSTOMER)

  // Set only for ADMIN and STORE_STAFF, who sign in with email and password instead of an OTP.
  passwordHash String?

  // Set only for STORE_STAFF: the store they work at.
  storeId String?

  // Set when a customer or rider deletes their account. Personal details are wiped and the phone
  // is replaced, so the number can sign up again as a new account; orders keep their snapshots.
  deletedAt DateTime?

  // Set only for CUSTOMER, by an admin: COD stops cash on delivery, ALL stops new orders. The
  // customer can still sign in, see orders, report issues and delete the account.
  orderBlock       CustomerBlock?
  orderBlockReason String?
  orderBlockedAt   DateTime?
  orderBlockedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderBlockedBy       User?            @relation("CustomerBlockedBy", fields: [orderBlockedById], references: [id])
  customersBlocked     User[]           @relation("CustomerBlockedBy")
  store                Store?           @relation(fields: [storeId], references: [id])
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  deliveryPartner      DeliveryPartner?
  cashDepositsRecorded CashDeposit[]    @relation("CashDepositRecordedBy")
  cashDepositsVoided   CashDeposit[]    @relation("CashDepositVoidedBy")
  payoutsRecorded      RiderPayout[]    @relation("RiderPayoutRecordedBy")
  payoutsVoided        RiderPayout[]    @relation("RiderPayoutVoidedBy")
  pushTokens           PushToken[]
  complaints           Complaint[]
  complaintsResolved   Complaint[]      @relation("ComplaintResolvedBy")
  refundsIssued        Refund[]         @relation("RefundCreatedBy")

  @@index([role])
  @@index([storeId])
}

enum UserRole {
  CUSTOMER
  ADMIN
  STORE_STAFF
  DELIVERY_PARTNER
}

enum CustomerBlock {
  COD
  ALL
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id     String @id @default(cuid())
  userId String

  label String?
  name  String
  phone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// STORES
// ─────────────────────────────────────────────

model Store {
  id     String      @id @default(cuid())
  name   String
  code   String      @unique
  phone  String?
  status StoreStatus @default(ACTIVE)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  serviceRadiusKm Decimal @default(3) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     StoreProduct[]
  orders       Order[]
  carts        Cart[]
  staff        User[]
  hours        StoreHours[]
  cashDeposits CashDeposit[]

  @@index([status])
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

// Opening hours in the deployment's TIMEZONE. A store with no rows is always open; once any day is
// set, a day without a row is closed. closesAt earlier than opensAt means the store closes after midnight.
model StoreHours {
  storeId   String
  // 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  opensAt   String // "HH:mm"
  closesAt  String // "HH:mm"

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, dayOfWeek])
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

// Two levels at most: top-level categories and their sub-categories.
model Category {
  id        String  @id @default(cuid())
  parentId  String?
  name      String
  slug      String  @unique
  imageUrl  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
}

model Brand {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

// What customers browse. The things actually sold are its variants: a product without options has
// exactly one (default) variant.
model Product {
  id         String  @id @default(cuid())
  categoryId String
  brandId    String?

  name        String
  slug        String   @unique
  description String?
  // Lowercase search keywords, e.g. "doodh".
  tags        String[] @default([])

  // GST. Prices include it.
  hsnCode String?
  gstRate Decimal? @db.Decimal(5, 2)

  // Label details for packaged goods.
  isVeg               Boolean?
  manufacturerName    String?
  manufacturerAddress String?
  countryOfOrigin     String?
  fssaiLicense        String?
  shelfLife           String?
  ingredients         String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id])
  options    ProductOption[]
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([tags], type: Gin)
}

// An axis a product varies along, e.g. "Size" or "Flavour".
model ProductOption {
  id        String @id @default(cuid())
  productId String

  name      String
  sortOrder Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String

  value     String
  sortOrder Int    @default(0)

  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([optionId, value])
}

// One sellable item, e.g. "Amul Taaza Milk · 1 L". Each variant has exactly one value of every option
// of its product, and no two variants of a product share the same combination.
model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku     String  @unique
  barcode String?
  // Built from the option values, e.g. "1 L · Chocolate". Empty for the default variant.
  name    String  @default("")

  unit     String?
  quantity Decimal? @db.Decimal(10, 2)

  // Most units of this variant one order can contain. Null means only the platform-wide limit applies.
  maxOrderQuantity Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id])
  optionValues ProductVariantOptionValue[]
  images       ProductImage[]
  stores       StoreProduct[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, sortOrder])
  @@index([barcode])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// Images of a product. With a variantId the image shows that variant; without, it is shared.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?

  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

// ─────────────────────────────────────────────
// STORE PRODUCTS / INVENTORY
// ─────────────────────────────────────────────

// A variant sold at a store: its price there, whether it is offered, and its stock.
model StoreProduct {
  id        String @id @default(cuid())
  storeId   String
  variantId String

  sellingPrice Decimal  @db.Decimal(10, 2)
  mrp          Decimal? @db.Decimal(10, 2)

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store                 @relation(fields: [storeId], references: [id])
  variant     ProductVariant        @relation(fields: [variantId], references: [id])
  inventory   Inventory?
  adjustments InventoryAdjustment[]

  @@unique([storeId, variantId])
  @@index([storeId, isAvailable])
  @@index([variantId])
}

model Inventory {
  id             String @id @default(cuid())
  storeProductId String @unique

  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id])
}

// Manual stock changes and items found missing while picking. Stock taken and returned by orders is
// not logged here; the orders record it.
model InventoryAdjustment {
  id             String @id @default(cuid())
  storeProductId String

  delta         Int
  quantityAfter Int
  reason        InventoryAdjustmentReason
  note          String?

  changedById String?

  createdAt DateTime @default(now())

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id])

  @@index([storeProductId, createdAt])
}

enum InventoryAdjustmentReason {
  RESTOCK
  CORRECTION
  DAMAGE
  ORDER_UNAVAILABLE
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model Cart {
  id      String  @id @default(cuid())
  userId  String  @unique
  storeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  store Store?     @relation(fields: [storeId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId    String
  storeId   String
  addressId String?

  status OrderStatus @default(PENDING_PAYMENT)

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  // GST included in the item prices.
  taxTotal    Decimal @default(0) @db.Decimal(10, 2)

  // Assigned when the order is delivered, e.g. INV/2026-27/000123.
  invoiceNumber String? @unique

  paymentMethod PaymentMethod

  // Address snapshot
  customerName  String
  customerPhone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  items     OrderItem[]
  payment   Payment?
  delivery  Delivery?
  complaint Complaint?
  rating    OrderRating?
  refunds   Refund[]

  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([storeId, status])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  STORE_ACCEPTED
  PICKING
  PACKED
  READY_FOR_PICKUP
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String

  // Historical product snapshot
  productName String
  variantName String   @default("")
  sku         String
  imageUrl    String?
  mrp         Decimal? @db.Decimal(10, 2)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  hsnCode   String?
  gstRate   Decimal? @db.Decimal(5, 2)
  // GST included in the charged units (quantity - unavailableQuantity).
  taxAmount Decimal  @default(0) @db.Decimal(10, 2)

  // Units the store could not find while picking; they are removed from the order total.
  unavailableQuantity Int @default(0)

  createdAt DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  complaintItems ComplaintItem[]

  @@index([orderId])
  @@index([variantId])
}

// Last invoice number used in each financial year, e.g. "2026-27".
model InvoiceSequence {
  financialYear String @id
  lastNumber    Int    @default(0)
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedById String?
  note        String?

  createdAt DateTime @default(now())

  // Set when the notification worker has handled this change (sent, or nothing to send).
  notifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([notifiedAt, createdAt])
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount         Decimal @db.Decimal(10, 2)
  // Every Refund of this payment adds up here: unavailable items, cancellation, complaints.
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  provider         String?
  transactionId    String?
  providerOrderId  String? @unique
  providerRefundId String?
  failureReason    String?

  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([status])
  @@index([transactionId])
}

// Money paid back to a customer: gateway refunds of online payments (automatic ones for
// cancellations and unavailable items, and those issued by admins), and cash-on-delivery refunds
// the business paid by UPI or bank transfer. Never deleted. Amounts are always positive (database check).
model Refund {
  id          String  @id @default(cuid())
  orderId     String
  paymentId   String
  complaintId String?

  amount    Decimal      @db.Decimal(10, 2)
  method    RefundMethod
  // Gateway refund ID, or the UPI / bank transaction reference.
  reference String?
  reason    String

  // Null for automatic refunds.
  createdById String?
  createdAt   DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id])
  payment   Payment    @relation(fields: [paymentId], references: [id])
  complaint Complaint? @relation(fields: [complaintId], references: [id])
  createdBy User?      @relation("RefundCreatedBy", fields: [createdById], references: [id])

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([complaintId])
}

enum RefundMethod {
  GATEWAY
  UPI
  BANK_TRANSFER
}

// ─────────────────────────────────────────────
// COMPLAINTS
// ─────────────────────────────────────────────

// A customer's report of a problem with a delivered order, at most one per order. An admin answers
// it with a refund, a resolution without one (e.g. the item was replaced), or a rejection.
model Complaint {
  id      String @id @default(cuid())
  orderId String @unique
  userId  String

  reason    ComplaintReason
  note      String?
  // Photos uploaded by the customer (URLs under /uploads/images), at most 3.
  photoUrls String[]        @default([])

  status         ComplaintStatus @default(OPEN)
  // The admin's answer, shown to the customer.
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order           @relation(fields: [orderId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  resolvedBy User?           @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id])
  items      ComplaintItem[]
  refunds    Refund[]

  @@index([status, createdAt])
  @@index([userId])
}

// An order item the complaint is about, and how many of its units.
model ComplaintItem {
  complaintId String
  orderItemId String
  quantity    Int

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@id([complaintId, orderItemId])
  @@index([orderItemId])
}

enum ComplaintReason {
  DAMAGED
  WRONG_ITEM
  MISSING
  EXPIRED
  OTHER
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  REJECTED
}

// ─────────────────────────────────────────────
// RATINGS
// ─────────────────────────────────────────────

// A customer's rating of a delivered order, at most one per order and never shown publicly. The
// delivery rating counts towards the rider who delivered it (Order → Delivery → partner).
// Stars are 1 to 5 (database checks).
model OrderRating {
  id      String @id @default(cuid())
  orderId String @unique

  deliveryRating Int
  itemsRating    Int?
  comment        String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([createdAt])
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// DELIVERY
// ─────────────────────────────────────────────

model DeliveryPartner {
  id     String @id @default(cuid())
  userId String @unique

  status   DeliveryPartnerStatus @default(OFFLINE)
  // Inactive partners cannot use the delivery app or be assigned.
  isActive Boolean               @default(true)

  vehicleType   String?
  vehicleNumber String?

  // Cash-on-delivery orders delivered from this time count towards cash in hand. Partners that
  // existed before cash tracking start at the time it was added.
  cashSince     DateTime @default(now())
  // Delivery earnings from this time count towards what the partner is owed; earlier ones were
  // settled before payouts were recorded.
  earningsSince DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  deliveries   Delivery[]
  cashDeposits CashDeposit[]
  payouts      RiderPayout[]

  @@index([status])
}

// Cash a partner handed over from cash-on-delivery orders. Never deleted: a mistake is voided
// with a reason and stays in the log. Amounts are always positive (database check).
model CashDeposit {
  id        String  @id @default(cuid())
  partnerId String
  amount    Decimal @db.Decimal(10, 2)
  // The store whose staff received it; null when an admin recorded it.
  storeId   String?
  note      String?

  recordedById String
  createdAt    DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  partner    DeliveryPartner @relation(fields: [partnerId], references: [id])
  store      Store?          @relation(fields: [storeId], references: [id])
  recordedBy User            @relation("CashDepositRecordedBy", fields: [recordedById], references: [id])
  voidedBy   User?           @relation("CashDepositVoidedBy", fields: [voidedById], references: [id])

  @@index([partnerId, createdAt])
  @@index([storeId, createdAt])
}

enum PayoutMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

// Earnings an admin paid a partner. Never deleted: a mistake is voided with a reason and stays
// in the log. Amounts are always positive (database check).
model RiderPayout {
  id        String       @id @default(cuid())
  partnerId String
  amount    Decimal      @db.Decimal(10, 2)
  method    PayoutMethod
  // Transaction or receipt reference, or anything else worth keeping.
  note      String?
  paidAt    DateTime

  recordedById String
  createdAt    DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  partner    DeliveryPartner @relation(fields: [partnerId], references: [id])
  recordedBy User            @relation("RiderPayoutRecordedBy", fields: [recordedById], references: [id])
  voidedBy   User?           @relation("RiderPayoutVoidedBy", fields: [voidedById], references: [id])

  @@index([partnerId, paidAt])
}

enum DeliveryPartnerStatus {
  OFFLINE
  ONLINE
  BUSY
}

model Delivery {
  id        String  @id @default(cuid())
  orderId   String  @unique
  partnerId String?

  status DeliveryStatus @default(PENDING)

  assignedAt  DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  deliveryOtpHash String?

  // Partner earning snapshot, set when delivered.
  earning Decimal? @db.Decimal(10, 2)

  // Why it failed, when an admin cancels the order after the rider picked it up.
  failure DeliveryFailure?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order            @relation(fields: [orderId], references: [id])
  partner DeliveryPartner? @relation(fields: [partnerId], references: [id])

  locations DeliveryLocation[]

  @@index([partnerId, status])
  @@index([status])
  @@index([failure])
}

enum DeliveryFailure {
  REFUSED
  UNREACHABLE
  OTHER
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model DeliveryLocation {
  id         String @id @default(cuid())
  deliveryId String

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  recordedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, recordedAt])
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

// Single row (id = "platform") of operational settings that admins can edit.
// Branding and the home screen live in AppAppearance.
model PlatformSettings {
  id String @id @default("platform")

  deliveryFee           Decimal  @db.Decimal(10, 2)
  // Null means delivery is never free.
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  minOrderValue         Decimal  @db.Decimal(10, 2)
  deliveryPartnerFee    Decimal  @db.Decimal(10, 2)

  // A partner holding this much cash or more can't be assigned orders until they deposit; null means no limit.
  riderCashLimit Decimal? @db.Decimal(10, 2)

  // Largest order total that can be paid cash on delivery; null means no limit.
  codMaxOrderValue Decimal? @db.Decimal(10, 2)

  // "Delivery in about N minutes" in the customer app's home header and checkout; null hides it.
  deliveryPromiseMinutes Int?

  supportPhone String?
  supportEmail String?

  // Legal name and registered address of the business, shown on the public policy and contact pages.
  businessName    String?
  businessAddress String?

  // Public website on SITE_DOMAIN: home page tagline and where to get the customer and delivery
  // partner apps. A direct download link only shows while that app has no store listing.
  websiteTagline       String?
  playStoreUrl         String?
  appStoreUrl          String?
  appDownloadUrl       String?
  deliveryPlayStoreUrl String?
  deliveryAppStoreUrl  String?
  deliveryDownloadUrl  String?

  // Review login for app store and payment gateway reviewers: this phone number signs in to a
  // customer account with a fixed code and no SMS. The code is stored only as an HMAC.
  reviewLoginEnabled  Boolean @default(false)
  reviewLoginPhone    String?
  reviewLoginCodeHash String?

  // Gateway new online payments use (e.g. "razorpay", "cashfree"); null means cash on delivery only.
  // Only gateways with working keys can be selected.
  paymentProvider String?

  // SMS provider that sends login OTPs (e.g. "message-central"). Null means none is set up: OTPs go to
  // the API log, in production for admins only. OTP_PROVIDER in the environment overrides this.
  otpProvider String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Policy pages of the public website (terms, privacy, refunds, shipping) as edited by admins.
// Without a row, the page shows the built-in template.
model PolicyPage {
  slug String @id
  body String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment gateway keys entered by admins in the dashboard, one row per gateway. `credentials` is a
// JSON object AES-256-GCM encrypted with SECRETS_ENCRYPTION_KEY; the API never returns it. Keys set
// in the server environment take priority over these.
model PaymentGatewayCredential {
  gateway String @id

  credentials String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SMS provider keys entered by admins in the dashboard, one row per provider. Stored like
// PaymentGatewayCredential: encrypted, never returned, and keys in the environment take priority.
model OtpProviderCredential {
  provider String @id

  credentials String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single row (id = "app"): the customer app's branding, theme and home screen layout, edited by
// admins. `config` follows the appearance schema in the API; missing keys fall back to defaults
// built from the environment. No row means the defaults are in use.
model AppAppearance {
  id String @id @default("app")

  config Json

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

// A device that receives push notifications for the signed-in user.
// A token belongs to one user; signing in as someone else on the device moves it.
model PushToken {
  id     String @id @default(cuid())
  userId String

  token    String         @unique
  platform DevicePlatform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
}

enum DevicePlatform {
  ANDROID
  IOS
}
