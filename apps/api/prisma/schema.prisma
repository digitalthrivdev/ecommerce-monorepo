generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id    String   @id @default(cuid())
  phone String   @unique
  name  String?
  email String?
  role  UserRole @default(CUSTOMER)

  // Set only for STORE_STAFF: the store they work at.
  storeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store           Store?           @relation(fields: [storeId], references: [id])
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  deliveryPartner DeliveryPartner?

  @@index([role])
  @@index([storeId])
}

enum UserRole {
  CUSTOMER
  ADMIN
  STORE_STAFF
  DELIVERY_PARTNER
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id     String @id @default(cuid())
  userId String

  label String?
  name  String
  phone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// STORES
// ─────────────────────────────────────────────

model Store {
  id     String      @id @default(cuid())
  name   String
  code   String      @unique
  phone  String?
  status StoreStatus @default(ACTIVE)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  serviceRadiusKm Decimal @default(3) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreProduct[]
  orders   Order[]
  carts    Cart[]
  staff    User[]

  @@index([status])
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  imageUrl  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id         String @id @default(cuid())
  categoryId String

  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  unit     String?
  quantity Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  stores     StoreProduct[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([categoryId])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// STORE PRODUCTS / INVENTORY
// ─────────────────────────────────────────────

model StoreProduct {
  id        String @id @default(cuid())
  storeId   String
  productId String

  sellingPrice Decimal  @db.Decimal(10, 2)
  mrp          Decimal? @db.Decimal(10, 2)

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  inventory Inventory?

  @@unique([storeId, productId])
  @@index([storeId, isAvailable])
  @@index([productId])
}

model Inventory {
  id             String @id @default(cuid())
  storeProductId String @unique

  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id])
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model Cart {
  id      String  @id @default(cuid())
  userId  String  @unique
  storeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  store Store?     @relation(fields: [storeId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId    String
  storeId   String
  addressId String?

  status OrderStatus @default(PENDING_PAYMENT)

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod

  // Address snapshot
  customerName  String
  customerPhone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  items    OrderItem[]
  payment  Payment?
  delivery Delivery?

  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([storeId, status])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  STORE_ACCEPTED
  PICKING
  PACKED
  READY_FOR_PICKUP
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // Historical product snapshot
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedById String?
  note        String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)

  provider         String?
  transactionId    String?
  providerOrderId  String? @unique
  providerRefundId String?
  failureReason    String?

  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([transactionId])
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// DELIVERY
// ─────────────────────────────────────────────

model DeliveryPartner {
  id     String @id @default(cuid())
  userId String @unique

  status   DeliveryPartnerStatus @default(OFFLINE)
  // Inactive partners cannot use the delivery app or be assigned.
  isActive Boolean               @default(true)

  vehicleType   String?
  vehicleNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]

  @@index([status])
}

enum DeliveryPartnerStatus {
  OFFLINE
  ONLINE
  BUSY
}

model Delivery {
  id        String  @id @default(cuid())
  orderId   String  @unique
  partnerId String?

  status DeliveryStatus @default(PENDING)

  assignedAt  DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  deliveryOtpHash String?

  // Partner earning snapshot, set when delivered.
  earning Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order            @relation(fields: [orderId], references: [id])
  partner DeliveryPartner? @relation(fields: [partnerId], references: [id])

  locations DeliveryLocation[]

  @@index([partnerId, status])
  @@index([status])
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model DeliveryLocation {
  id         String @id @default(cuid())
  deliveryId String

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  recordedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, recordedAt])
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

// Single row (id = "platform") of operational settings that admins can edit.
// Branding comes from environment configuration instead.
model PlatformSettings {
  id String @id @default("platform")

  deliveryFee           Decimal  @db.Decimal(10, 2)
  // Null means delivery is never free.
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  minOrderValue         Decimal  @db.Decimal(10, 2)
  deliveryPartnerFee    Decimal  @db.Decimal(10, 2)

  supportPhone String?
  supportEmail String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
