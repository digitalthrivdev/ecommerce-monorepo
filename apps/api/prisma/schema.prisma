generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id    String   @id @default(cuid())
  phone String   @unique
  name  String?
  // Stored lowercase. Admins and staff sign in with it.
  email String?  @unique
  role  UserRole @default(CUSTOMER)

  // Set only for ADMIN and STAFF, who sign in with email and password instead of an OTP.
  passwordHash String?

  // Set when a customer deletes their account. Personal details are wiped and the phone
  // is replaced, so the number can sign up again as a new account; orders keep their snapshots.
  deletedAt DateTime?

  // Set only for CUSTOMER, by an admin: COD stops cash on delivery, ALL stops new orders. The
  // customer can still sign in, see orders, report issues and delete the account.
  orderBlock       CustomerBlock?
  orderBlockReason String?
  orderBlockedAt   DateTime?
  orderBlockedById String?

  // Demo account given to prospects: a test admin can only read, and test staff and customers are
  // limited. Set with the test-account script; carried in the sign-in token.
  isTestAccount Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderBlockedBy      User?           @relation("CustomerBlockedBy", fields: [orderBlockedById], references: [id])
  customersBlocked    User[]          @relation("CustomerBlockedBy")
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  pushTokens          PushToken[]
  complaints          Complaint[]
  complaintsResolved  Complaint[]     @relation("ComplaintResolvedBy")
  refundsIssued       Refund[]        @relation("RefundCreatedBy")
  productReviews      ProductReview[]
  productReviewsAdded ProductReview[] @relation("ProductReviewCreatedBy")
  wishlistItems       WishlistItem[]

  @@index([role])
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum CustomerBlock {
  COD
  ALL
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id     String @id @default(cuid())
  userId String

  label String?
  name  String
  phone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// PICKUP LOCATIONS
// ─────────────────────────────────────────────

// An address carriers collect parcels from. Once any exist, exactly one is the default (kept by the
// API); its address and state are the seller's on invoices.
model PickupLocation {
  id   String @id @default(cuid())
  // Short name shown in the dashboard and given to carriers, e.g. "Main warehouse".
  name String @unique

  contactName String
  phone       String
  email       String?

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

// Two levels at most: top-level categories and their sub-categories.
model Category {
  id        String  @id @default(cuid())
  parentId  String?
  name      String
  slug      String  @unique
  imageUrl  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
}

model Brand {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

// What customers browse. The things actually sold are its variants: a product without options has
// exactly one (default) variant.
model Product {
  id         String  @id @default(cuid())
  categoryId String
  brandId    String?

  name        String
  slug        String   @unique
  description String?
  // Lowercase search keywords, e.g. "doodh".
  tags        String[] @default([])

  // GST. Prices include it.
  hsnCode String?
  gstRate Decimal? @db.Decimal(5, 2)

  manufacturerName    String?
  manufacturerAddress String?
  countryOfOrigin     String?

  // Shown on the product page in this order: [{ "name": "Material", "value": "Cotton" }, …].
  specifications Json @default("[]")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id])
  options    ProductOption[]
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    ProductReview[]
  wishlist   WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([tags], type: Gin)
}

// An axis a product varies along, e.g. "Size" or "Flavour".
model ProductOption {
  id        String @id @default(cuid())
  productId String

  name      String
  sortOrder Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String

  value     String
  sortOrder Int    @default(0)

  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([optionId, value])
}

// One sellable item, e.g. "Cotton T-shirt · M · Blue". Each variant has exactly one value of every
// option of its product, and no two variants of a product share the same combination.
model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku     String  @unique
  barcode String?
  // Built from the option values, e.g. "M · Blue". Empty for the default variant.
  name    String  @default("")

  unit     String?
  quantity Decimal? @db.Decimal(10, 2)

  // Selling price, GST included.
  price          Decimal  @db.Decimal(10, 2)
  // The higher price shown struck through (e.g. the MRP); at least the price (database check).
  compareAtPrice Decimal? @db.Decimal(10, 2)

  // Packed weight and size, for carriers.
  weightGrams Int?
  lengthCm    Decimal? @db.Decimal(7, 2)
  breadthCm   Decimal? @db.Decimal(7, 2)
  heightCm    Decimal? @db.Decimal(7, 2)

  // Most units of this variant one order can contain. Null means only the platform-wide limit applies.
  maxOrderQuantity Int?

  // Inactive variants can't be bought; staff switch them off when they run out for a while.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id])
  optionValues ProductVariantOptionValue[]
  images       ProductImage[]
  inventory    Inventory?
  adjustments  InventoryAdjustment[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, sortOrder])
  @@index([barcode])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// Images of a product. With a variantId the image shows that variant; without, it is shared.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?

  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

// Stock of a variant. Never negative (database check).
model Inventory {
  id        String @id @default(cuid())
  variantId String @unique

  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])
}

// Manual stock changes and items found missing while picking. Stock taken and returned by orders is
// not logged here; the orders record it.
model InventoryAdjustment {
  id        String @id @default(cuid())
  variantId String

  delta         Int
  quantityAfter Int
  reason        InventoryAdjustmentReason
  note          String?

  changedById String?

  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

enum InventoryAdjustmentReason {
  RESTOCK
  CORRECTION
  DAMAGE
  ORDER_UNAVAILABLE
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  // Coupon code the customer applied; checked again on every cart view and at checkout.
  couponCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId    String
  addressId String?

  status OrderStatus @default(PENDING_PAYMENT)

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  // GST included in the item prices and, for orders placed since the delivery fee GST rate was
  // added, in the delivery fee.
  taxTotal    Decimal @default(0) @db.Decimal(10, 2)

  // GST rate of the delivery fee and the tax included in it. Null rate: placed before it was recorded.
  deliveryFeeGstRate Decimal? @db.Decimal(5, 2)
  deliveryFeeTax     Decimal  @default(0) @db.Decimal(10, 2)

  // Assigned when the order is packed, e.g. INV/2026-27/000123, and dated invoicedAt.
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  // Seller snapshot for the invoice, taken with the invoice number: legal name, GSTIN (null when
  // none applies) and the default pickup location's address. interStateSupply is true when that
  // location and the delivery address are in different states (IGST), false for CGST + SGST.
  // Address and interStateSupply are null when no pickup location was set up.
  sellerName       String?
  sellerGstin      String?
  sellerAddress    String?
  interStateSupply Boolean?

  // The coupon that gave `discount`, and its code as entered.
  couponId   String?
  couponCode String?

  paymentMethod PaymentMethod

  // Address snapshot
  customerName  String
  customerPhone String

  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id], onDelete: Restrict)

  items          OrderItem[]
  payment        Payment?
  complaint      Complaint?
  rating         OrderRating?
  shipment       Shipment?
  refunds        Refund[]
  productReviews ProductReview[]

  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId, userId])
}

// SHIPPED onwards follow the shipment (see shipping/shipment-status.ts). RTO: the parcel is
// going back to, or is back at, the pickup location.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String

  // Historical product snapshot
  productName    String
  variantName    String   @default("")
  sku            String
  imageUrl       String?
  compareAtPrice Decimal? @db.Decimal(10, 2)
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)

  hsnCode   String?
  gstRate   Decimal? @db.Decimal(5, 2)
  // This item's share of the order's coupon discount, on the charged units.
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  // GST included in the charged units (quantity - unavailableQuantity), after the discount.
  taxAmount Decimal  @default(0) @db.Decimal(10, 2)

  // Units that could not be found while picking; they are removed from the order total.
  unavailableQuantity Int @default(0)

  createdAt DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  complaintItems ComplaintItem[]

  @@index([orderId])
  @@index([variantId])
}

// Last invoice number used in each financial year, e.g. "2026-27".
model InvoiceSequence {
  financialYear String @id
  lastNumber    Int    @default(0)
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedById String?
  note        String?

  createdAt DateTime @default(now())

  // Set when the notification worker has handled this change (sent, or nothing to send).
  notifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([notifiedAt, createdAt])
}

// ─────────────────────────────────────────────
// SHIPPING
// ─────────────────────────────────────────────

// One shipment per order. A cancelled shipment is reused when the order is shipped again, so its
// events stay in the order's tracking history.
model Shipment {
  id      String @id @default(cuid())
  orderId String @unique

  // Carrier that carries it (e.g. "manual", "shiprocket"), fixed for the shipment's life.
  provider           String
  providerOrderId    String?
  providerShipmentId String?
  awb                String?
  courierName        String?
  trackingUrl        String?
  labelUrl           String?

  status   ShipmentStatus @default(PENDING)
  // When the event that set `status` happened, so a late webhook doesn't move it back.
  statusAt DateTime       @default(now())

  // Parcel as booked with the carrier.
  weightGrams Int
  lengthCm    Decimal @db.Decimal(7, 2)
  breadthCm   Decimal @db.Decimal(7, 2)
  heightCm    Decimal @db.Decimal(7, 2)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order           @relation(fields: [orderId], references: [id])
  events ShipmentEvent[]

  @@unique([provider, awb])
  @@index([provider, providerShipmentId])
}

enum ShipmentStatus {
  PENDING
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  // Delivery attempt failed (customer unavailable, refused, wrong address); the carrier retries.
  NDR
  RTO_IN_TRANSIT
  RTO_DELIVERED
  CANCELLED
  LOST
}

// Tracking history from carrier webhooks, tracking syncs and admins (manual carrier).
model ShipmentEvent {
  id         String @id @default(cuid())
  shipmentId String

  status          ShipmentStatus
  // The carrier's id for the event, or one derived from its content: each event is recorded once.
  providerEventId String
  occurredAt      DateTime
  location        String?
  description     String?

  // The admin who recorded it; null for carrier events.
  createdById String?

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt])
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount         Decimal @db.Decimal(10, 2)
  // Every Refund of this payment adds up here: unavailable items, cancellation, complaints.
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  provider         String?
  transactionId    String?
  providerOrderId  String? @unique
  providerRefundId String?
  failureReason    String?

  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([status])
  @@index([transactionId])
  @@index([paidAt])
}

// Money paid back to a customer: gateway refunds of online payments (automatic ones for
// cancellations and unavailable items, and those issued by admins), and cash-on-delivery refunds
// the business paid by UPI or bank transfer. Never deleted. Amounts are always positive (database check).
model Refund {
  id          String  @id @default(cuid())
  orderId     String
  paymentId   String
  complaintId String?

  amount    Decimal      @db.Decimal(10, 2)
  method    RefundMethod
  // Gateway refund ID, or the UPI / bank transaction reference.
  reference String?
  reason    String

  // Null for automatic refunds.
  createdById String?
  createdAt   DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id])
  payment   Payment    @relation(fields: [paymentId], references: [id])
  complaint Complaint? @relation(fields: [complaintId], references: [id])
  createdBy User?      @relation("RefundCreatedBy", fields: [createdById], references: [id])

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([complaintId])
}

enum RefundMethod {
  GATEWAY
  UPI
  BANK_TRANSFER
}

// ─────────────────────────────────────────────
// COMPLAINTS
// ─────────────────────────────────────────────

// A customer's report of a problem with a delivered order, at most one per order. An admin answers
// it with a refund, a resolution without one (e.g. the item was replaced), or a rejection.
model Complaint {
  id      String @id @default(cuid())
  orderId String @unique
  userId  String

  reason    ComplaintReason
  note      String?
  // Photos uploaded by the customer (URLs under /uploads/images), at most 3.
  photoUrls String[]        @default([])

  status         ComplaintStatus @default(OPEN)
  // The admin's answer, shown to the customer.
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order           @relation(fields: [orderId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  resolvedBy User?           @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id])
  items      ComplaintItem[]
  refunds    Refund[]

  @@index([status, createdAt])
  @@index([userId])
}

// An order item the complaint is about, and how many of its units.
model ComplaintItem {
  complaintId String
  orderItemId String
  quantity    Int

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@id([complaintId, orderItemId])
  @@index([orderItemId])
}

enum ComplaintReason {
  DAMAGED
  WRONG_ITEM
  MISSING
  EXPIRED
  OTHER
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  REJECTED
}

// ─────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────

// A code the customer enters at checkout for a discount on the items (not the delivery fee).
// One coupon per order, no stacking. Cancelled orders don't count towards the limits. Once an order
// has used it, the code and discount (type, value, maximum) can't change, so orders can be
// recalculated when an item can't be found. Values are checked by the database.
model Coupon {
  id          String  @id @default(cuid())
  // Stored uppercase.
  code        String  @unique
  // Shown to customers, e.g. "Flat ₹50 off your first order".
  description String?

  discountType  CouponDiscountType
  // An amount for FLAT, a percentage for PERCENT.
  discountValue Decimal            @db.Decimal(10, 2)
  // PERCENT only: the most the discount can be.
  maxDiscount   Decimal?           @db.Decimal(10, 2)
  // Item total needed, before the discount.
  minOrderValue Decimal            @default(0) @db.Decimal(10, 2)

  startsAt DateTime?
  // Exclusive: the coupon stops working at this moment.
  endsAt   DateTime?

  // Orders that may use it in total, and per customer.
  totalLimit       Int?
  perCustomerLimit Int?
  // Only for customers with no earlier order (cancelled orders don't count).
  firstOrderOnly   Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, createdAt])
}

enum CouponDiscountType {
  FLAT
  PERCENT
}

// ─────────────────────────────────────────────
// RATINGS
// ─────────────────────────────────────────────

// A customer's rating of a delivered order, at most one per order and never shown publicly.
// Stars are 1 to 5 (database checks).
model OrderRating {
  id      String @id @default(cuid())
  orderId String @unique

  deliveryRating Int
  itemsRating    Int?
  comment        String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([createdAt])
}

enum ReviewSource {
  // A customer rating a product from their delivered order: a verified purchase.
  CUSTOMER
  // Added by an admin under a name they enter; never shown as a verified purchase.
  ADMIN
}

// A rating of a product. Customers review what they received, one per customer and product (rating
// it again replaces it); admins can add reviews under any name.
model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  source      ReviewSource @default(CUSTOMER)
  // CUSTOMER reviews only.
  userId      String?
  // CUSTOMER reviews only: the delivered order that let the customer review it.
  orderId     String?
  // ADMIN reviews only: the name shown with the review.
  authorName  String?
  createdById String?

  rating  Int
  comment String?

  // Hidden by an admin: kept, but left out of the product's rating and reviews.
  isHidden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("ProductReviewCreatedBy", fields: [createdById], references: [id])

  @@unique([userId, productId])
  @@index([productId, isHidden, updatedAt])
  @@index([createdAt])
}

// A product a customer saved for later. One per product, whatever the variant.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

// Single row (id = "platform") of operational settings that admins can edit.
// Branding and the home screen live in AppAppearance.
model PlatformSettings {
  id String @id @default("platform")

  deliveryFee           Decimal  @db.Decimal(10, 2)
  // Null means delivery is never free.
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  minOrderValue         Decimal  @db.Decimal(10, 2)

  // Largest order total that can be paid cash on delivery; null means no limit.
  codMaxOrderValue Decimal? @db.Decimal(10, 2)

  // "Delivery in about N minutes" in the customer app's home header and checkout; null hides it.
  deliveryPromiseMinutes Int?

  supportPhone String?
  supportEmail String?

  // Legal name and registered address of the business, shown on the public policy and contact pages.
  // The legal name is also the seller on GST invoices.
  businessName    String?
  businessAddress String?

  // GSTIN on invoices, when it is registered in the state of the default pickup location.
  gstin              String?
  // GST rate included in the delivery fee.
  deliveryFeeGstRate Decimal @default(18) @db.Decimal(5, 2)

  // Public website on SITE_DOMAIN: home page tagline and where to get the customer app. A direct
  // download link only shows while the app has no store listing.
  websiteTagline String?
  playStoreUrl   String?
  appStoreUrl    String?
  appDownloadUrl String?

  // Review login for app store and payment gateway reviewers: this phone number signs in to a
  // customer account with a fixed code and no SMS. The code is stored only as an HMAC.
  reviewLoginEnabled  Boolean @default(false)
  reviewLoginPhone    String?
  reviewLoginCodeHash String?

  // Gateway new online payments use (e.g. "razorpay", "cashfree"); null means cash on delivery only.
  // Only gateways with working keys can be selected.
  paymentProvider String?

  // SMS provider that sends login OTPs (e.g. "message-central"). Null means none is set up: OTPs go to
  // the API log, in production for admins only. OTP_PROVIDER in the environment overrides this.
  otpProvider String?

  // Carrier new shipments are booked with (e.g. "shiprocket"). Null: manual, the admin books the
  // courier and types the AWB. Only carriers with working keys can be selected.
  shippingProvider String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Policy pages of the public website (terms, privacy, refunds, shipping) as edited by admins.
// Without a row, the page shows the built-in template.
model PolicyPage {
  slug String @id
  body String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment gateway keys entered by admins in the dashboard, one row per gateway. `credentials` is a
// JSON object AES-256-GCM encrypted with SECRETS_ENCRYPTION_KEY; the API never returns it. Keys set
// in the server environment take priority over these.
model PaymentGatewayCredential {
  gateway String @id

  credentials String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shipping carrier keys entered by admins in the dashboard, one row per carrier. Stored like
// PaymentGatewayCredential: encrypted, never returned, and keys in the environment take priority.
model ShippingCarrierCredential {
  carrier String @id

  credentials String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SMS provider keys entered by admins in the dashboard, one row per provider. Stored like
// PaymentGatewayCredential: encrypted, never returned, and keys in the environment take priority.
model OtpProviderCredential {
  provider String @id

  credentials String

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single row (id = "app"): the customer app's branding, theme and home screen layout, edited by
// admins. `config` follows the appearance schema in the API; missing keys fall back to defaults
// built from the environment. No row means the defaults are in use.
model AppAppearance {
  id String @id @default("app")

  config Json

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

// A device that receives push notifications for the signed-in user.
// A token belongs to one user; signing in as someone else on the device moves it.
model PushToken {
  id     String @id @default(cuid())
  userId String

  token    String         @unique
  platform DevicePlatform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
}

enum DevicePlatform {
  ANDROID
  IOS
}
