NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Behind a reverse proxy, the number of proxy hops (e.g. 1 for one Nginx) or the proxy IPs/CIDRs,
# so rate limits see the real client IP. Leave unset when clients connect to the API directly.
# Never use "true" if the API port is also reachable without the proxy.
# TRUST_PROXY=1

DATABASE_URL="postgresql://shop:shop_dev@localhost:5434/shop"

REDIS_URL="redis://localhost:6380"

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-of-32-plus-chars"
JWT_EXPIRES_IN=7d

# Initial client branding. These seed the app appearance on first use; after that, change the
# name, logo, colours and home screen from the admin dashboard (Appearance).
APP_NAME=Shop
# LOGO_URL=https://cdn.example.com/logo.png
# Quote colours: an unquoted "#" starts a comment in .env files
PRIMARY_COLOR="#0C831F"
SECONDARY_COLOR="#F8CB46"
TIMEZONE=Asia/Kolkata
CURRENCY=INR

# Initial order pricing (decimal amounts in the client's currency). These seed the platform
# settings on first use; after that, change them from the admin dashboard.
DELIVERY_FEE=25.00
FREE_DELIVERY_THRESHOLD=199.00
MIN_ORDER_VALUE=99.00

# Encrypts the payment gateway, SMS provider and shipping carrier keys admins save in the dashboard.
# Required to save keys there; generate with `openssl rand -base64 32`. Changing it means the saved
# keys must be entered again.
SECRETS_ENCRYPTION_KEY=

# Online payments. Admins enter gateway keys and pick the active gateway under Settings in the
# dashboard (or leave online payments off for cash on delivery only). Outside production a
# "Test gateway" that charges nothing is always available.
#
# Public https URL of this API. The gateways return customers and send webhooks here.
# In development it can stay unset (the app's API address is used).
# PUBLIC_API_URL=https://api.example.com
#
# Public website (home page plus Terms, Privacy, Refunds, Shipping and Contact pages). The apps
# link to its policy pages; unset hides the links.
# PUBLIC_SITE_URL=https://example.com
#
# Optional: keys set below take priority over the dashboard and cannot be edited there.
#
# Razorpay (Dashboard > Account & Settings > API Keys / Webhooks). Webhook URL:
#   <PUBLIC_API_URL>/payments/webhooks/razorpay  with events payment.captured and payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
#
# Cashfree Payments (Developers > API Keys). Webhook URL (payment events):
#   <PUBLIC_API_URL>/payments/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" for test keys, "production" for live keys
CASHFREE_ENVIRONMENT=sandbox
#
# Unpaid online orders are cancelled after this many minutes
PAYMENT_TIMEOUT_MINUTES=15
# How often to cancel expired unpaid orders and retry refunds (0 disables)
PAYMENT_SWEEP_INTERVAL_SECONDS=60

# Shipping. Admins add carrier keys and pick the active carrier under Settings → Shipping in the
# dashboard. The manual carrier (book the courier yourself) needs no keys. Outside production a
# "Test carrier" is always available.
#
# Optional: Shiprocket (https://www.shiprocket.in) keys set here take priority over the dashboard.
# Create the API user under Settings → API in the Shiprocket account; set the webhook at
# Settings → API → Webhooks with URL <PUBLIC_API_URL>/shipping/webhooks/shiprocket and the same
# security token; pickup location is the nickname of the address under Settings → Pickup Addresses.
# Set all four or none.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=

# Optional: Fship (https://www.fship.in) keys set here take priority over the dashboard.
# The Client Key is under Settings → API Details; the address id is the pickup warehouse under
# Manage Warehouse. Fship has no webhooks, so progress is pulled from the order page.
# Set both or neither. FSHIP_BASE_URL (e.g. https://capi-qc.fship.in) is for the staging API only.
FSHIP_CLIENT_KEY=
FSHIP_PICKUP_ADDRESS_ID=
# FSHIP_BASE_URL=

# Login OTP by SMS. Admins add SMS provider keys and choose the provider under Settings in the
# dashboard (needs SECRETS_ENCRYPTION_KEY). Until one is set up, codes are written to the API log:
# for everyone in development, and in production only for existing admins, so the first admin can
# sign in and set it up. Customers cannot sign in until then.
#
# Optional override of the dashboard choice, e.g. to recover access: "message-central", or "log"
# (development only).
# OTP_PROVIDER=
#
# OTP sends allowed per client IP per hour across all phone numbers (each phone also has its own
# limit of 5 per hour). Mobile networks share one IP between many customers; keep it generous.
OTP_SENDS_PER_IP_PER_HOUR=30
#
# Optional: Message Central (https://www.messagecentral.com, VerifyNow) keys set here take priority
# over the dashboard. Customer ID from the console; the key is your account password Base64-encoded,
# e.g. `printf '%s' 'your-password' | base64`. Only phone numbers with MESSAGE_CENTRAL_COUNTRY_CODE
# can sign in.
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_KEY=
MESSAGE_CENTRAL_COUNTRY_CODE=91
MESSAGE_CENTRAL_EMAIL=

# Sales demos only: test-account logins shown on the dashboard and app sign-in screens (one tap).
# Public via GET /settings. Any of admin/staff ({email,password}) and customer ({phone,code}).
# DEMO_LOGINS='{"admin":{"email":"admin@shop.test","password":"shop-dev"},"customer":{"phone":"+919000000002","code":"123456"}}'

# Push notifications: "expo" (Expo push service, needs app builds with push set up),
# "log" (development only; written to the API log) or "none" (disabled)
PUSH_PROVIDER=log
# Only needed if "enhanced push security" is enabled for the Expo projects
# EXPO_ACCESS_TOKEN=
# How often to send pushes for new order status changes (0 disables)
NOTIFICATION_INTERVAL_SECONDS=3

# Error tracking (Sentry, or a Sentry-compatible server such as GlitchTip). Blank turns it off.
# In production it comes from SENTRY_DSN in deploy/.env.
SENTRY_DSN=

# Folder for uploaded images (relative to apps/api). Served at /uploads/.
# UPLOADS_DIR=uploads
