{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.21.0",
      "pnpm": "11.8.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true
    },
    "example-preview": {
      "extends": "preview",
      "env": {
        "APP_BRAND": "example",
        "APP_NAME": "Example Shop",
        "APP_ID": "com.example.shop",
        "APP_SCHEME": "exampleshop",
        "SITE_DOMAIN": "example.com",
        "EXPO_PUBLIC_API_URL": "https://api.example.com",
        "EAS_PROJECT_ID": "",
        "EXPO_OWNER": ""
      }
    },
    "example-production": {
      "extends": "production",
      "env": {
        "APP_BRAND": "example",
        "APP_NAME": "Example Shop",
        "APP_ID": "com.example.shop",
        "APP_SCHEME": "exampleshop",
        "SITE_DOMAIN": "example.com",
        "EXPO_PUBLIC_API_URL": "https://api.example.com",
        "EAS_PROJECT_ID": "",
        "EXPO_OWNER": ""
      }
    },
    "moozy-preview": {
      "extends": "preview",
      "env": {
        "APP_BRAND": "moozy",
        "APP_NAME": "Moozy Shop",
        "APP_ID": "in.moozy.shop",
        "APP_SCHEME": "moozyshop",
        "SITE_DOMAIN": "shop.moozy.in",
        "EXPO_PUBLIC_API_URL": "https://shop-api.moozy.in",
        "EAS_PROJECT_ID": "",
        "EXPO_OWNER": ""
      }
    },
    "moozy-production": {
      "extends": "production",
      "env": {
        "APP_BRAND": "moozy",
        "APP_NAME": "Moozy Shop",
        "APP_ID": "in.moozy.shop",
        "APP_SCHEME": "moozyshop",
        "SITE_DOMAIN": "shop.moozy.in",
        "EXPO_PUBLIC_API_URL": "https://shop-api.moozy.in",
        "EAS_PROJECT_ID": "",
        "EXPO_OWNER": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
