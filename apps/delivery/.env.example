# Copy to .env. Values prefixed with EXPO_PUBLIC_ are bundled into the app, so never put secrets here.

# API base URL. In development it defaults to port 4000 on the machine running `expo start`,
# which works for a phone on the same network. Set it for builds and when that guess is wrong
# (for example WSL2 without mirrored networking: use the Windows host's LAN IP).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Sign-in phone field. The API stores numbers in E.164 (country code + national number).
EXPO_PUBLIC_PHONE_COUNTRY_CODE=+91
EXPO_PUBLIC_PHONE_NATIONAL_LENGTH=10
