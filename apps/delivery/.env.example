# Copy to .env. Values prefixed with EXPO_PUBLIC_ are bundled into the app, so never put secrets here.

# Local API while running Metro. Defaults to port 4000 on the machine serving the bundle (works for
# a phone on the same network). Set this when that guess is wrong: Android emulator use
# http://10.0.2.2:4000; WSL2 without mirrored networking use the Windows host's LAN IP; or a tunnel.
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.10:4000

# Production and preview builds set EXPO_PUBLIC_API_URL in eas.json (e.g. https://api.example.com).
# It is ignored while __DEV__ is true, so a leftover value cannot point Metro at production.

# Error tracking (Sentry): builds set EXPO_PUBLIC_SENTRY_DSN per client in eas.json. Reporting is off
# while __DEV__ is true and when the DSN is blank.

# Sign-in phone field. The API stores numbers in E.164 (country code + national number).
EXPO_PUBLIC_PHONE_COUNTRY_CODE=+91
EXPO_PUBLIC_PHONE_NATIONAL_LENGTH=10
